# Both values are public by design: the URL and the publishable (anon) key ship
# in the browser bundle, and Row Level Security limits what the key can read.
# Never add the secret (service role) key here or anywhere in this repository.
#
# Copy to .env.development (used by `yarn dev`) and .env.local (used by every
# mode, including `yarn build` and `yarn start`). Both are gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only (no NEXT_PUBLIC_ prefix, never reaches the browser bundle). The
# shared secret the toolkit's database trigger sends in the x-adw-secret header
# when it posts a history change to /api/revalidate; the handler rejects every
# request until this is set. Generate with `openssl rand -hex 32` and set the
# same value as the database setting app.settings.dashboard_revalidate_secret
# (see README, "Webhook revalidation"). Put the real value in .env.local (and
# in the host's environment), never in this file.
ADW_REVALIDATE_SECRET=replace_me_with_openssl_rand_hex_32
