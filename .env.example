# This file carries BOTH the app's configuration and the ADW toolkit's. The app
# reads .env.development (dev) and .env.local (every mode); the toolkit reads
# .env.development only, from the repository root. Keep the app values identical
# in both files; the ADW_* and CLAUDE_* keys below belong in .env.development.
#
# Both values are public by design: the URL and the publishable (anon) key ship
# in the browser bundle, and Row Level Security limits what the key can read.
# Never add the secret (service role) key here or anywhere in this repository.
#
# Copy to .env.development (used by `yarn dev`) and .env.local (used by every
# mode, including `yarn build` and `yarn start`). Both are gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only (no NEXT_PUBLIC_ prefix, never reaches the browser bundle). The
# shared secret the toolkit's database trigger sends in the x-adw-secret header
# when it posts a history change to /api/revalidate; the handler rejects every
# request until this is set. Generate with `openssl rand -hex 32` and set the
# same value as the database setting app.settings.dashboard_revalidate_secret
# (see README, "Webhook revalidation"). Put the real value in .env.local (and
# in the host's environment), never in this file.
ADW_REVALIDATE_SECRET=replace_me_with_openssl_rand_hex_32

# The /hire contact form. The three server-only values are read only in
# src/app/actions/send-hire-request.ts; the public site key is read only by
# src/app/hire/page.tsx. The Turnstile placeholders are Cloudflare's documented
# always-pass test keys, so the form works locally without a real widget. Put
# the real values in .env.local (and in the host's environment), never in this
# file. Unset, the page still builds and the action answers ?error=send.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL="Hire form <hire-form@example.com>"

# ---------------------------------------------------------------------------
# ADW toolkit (read from .env.development by adws/, which is symlinked in from
# the adw-toolkit checkout; see README, "ADW"). Paths and names, no secrets.
# GitHub access comes from `gh auth login`, not from a token here.
# ---------------------------------------------------------------------------
# Path to the Claude Code CLI; `claude` if it is on PATH.
CLAUDE_CODE_PATH=claude
# Absolute path of this checkout. Everything a run writes (agents/, trees/) lands under it.
ADW_PROJECT_ROOT=/absolute/path/to/adw-dashboard
# Branch new worktrees branch from and pull requests target.
ADW_BASE_BRANCH=develop
# Name shown for this project in the ADW dashboard; seeds a new project row only.
ADW_UI_DISPLAY_NAME=ADW Dashboard
